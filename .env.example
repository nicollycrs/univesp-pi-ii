# Modelo de variaveis de ambiente para desenvolvimento LOCAL.
# Copiar para .env na raiz do projeto e preencher.
# O arquivo .env NUNCA vai para o GitHub (ja bloqueado no .gitignore).
# Em producao, estes valores sao cadastrados no painel do Render.

# Connection string do Neon (Dashboard > Connection string).
# Sem esta variavel o projeto usa SQLite local, o que basta para desenvolver.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Gerar uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cole-aqui-a-chave-gerada

# True apenas na maquina local. Em producao e sempre False.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
